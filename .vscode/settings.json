{
  "prettier.documentSelectors": ["**/*.astro"],
  "[astro]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "eslint.validate": ["javascript", "astro", "typescript", "typescriptreact"],
  "css.validate": false,
  "scss.validate": false,
  "stylelint.validate": ["astro", "css", "scss"],
  "typescript.validate.enable": false
}

{
  "name": "digital-garden",
  "type": "module",
  "version": "0.3.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist && cp -r dist/pagefind public/",
    "preview": "astro preview",
    "astro": "astro",
    "format": "prettier --write .",

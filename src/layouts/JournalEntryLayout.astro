---
import BaseLayout from "@layouts/BaseLayout.astro";
const { frontmatter } = Astro.props;

const locale = "en-US";
const options = {
  month: "short",
  day: "numeric",
  year: "numeric",
};
---

<BaseLayout pageTitle={frontmatter.title}>
  <main>
    <article class="flow">
      <h1>{frontmatter.title}</h1>
      <p class="lede">{frontmatter.lede}</p>
      <p class="byline">
        {frontmatter.pubDate.toLocaleDateString(locale, options)}
      </p>
      <slot />
    </article>
  </main>
</BaseLayout>

---
import TableOfContents from "@components/TableOfContents.astro";
import BaseLayout from "@layouts/BaseLayout.astro";

const { frontmatter, headings, minutesRead } = Astro.props;

const locale = "en-US";
const options = {
  month: "short",
  day: "numeric",
  year: "numeric",
};
---

<style lang="scss">
  @use "@styles/colors";
  @use "@styles/size-steps";
  @use "@styles/weights";

  .lede {
    font-size: size-steps.$step-2;
    line-height: 1.3;
    text-align: center;
    text-wrap: balance;
  }

  .byline {
    display: flex;
    max-width: 200px;
    justify-content: space-between;
    margin: 0 auto;
    color: colors.$battleship-gray;
    font-size: size-steps.$step-0;
    font-weight: weights.$semibold;
    text-align: center;

    --flow-space: 0.5em;
  }

  .byline + * {
    --flow-space: 2em;
  }

  .lede + *:not(.byline) {
    --flow-space: 2em;
  }
</style>

<BaseLayout pageTitle={frontmatter.title}>
  <main data-pagefind-body class="flow">
    <h1>{frontmatter.title}</h1>
    <p class="lede">{frontmatter.lede}</p>
    <span class="byline">
      <!-- TODO: Switch to Day.js https://www.npmjs.com/package/dayjs -->
      <p>{frontmatter.pubDate.toLocaleDateString(locale, options)}</p>
      <p>&#x2022;</p>
      <p>{minutesRead}</p>
    </span>
    {headings.length > 0 && <TableOfContents headings={headings} />}
    <slot />
  </main>
</BaseLayout>

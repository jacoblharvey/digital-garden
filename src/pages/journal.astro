---
import { getCollection } from "astro:content";

import BaseLayout from "@layouts/BaseLayout.astro";
import JournalEntryCard from "@components/JournalEntryCard.astro";

const allEntries = await getCollection("journal");
const pageTitle = "Journal";
const locale = "en-US";
const options = {
  month: "short",
  day: "numeric",
  year: "numeric",
};
---

<style lang="scss">
  ul {
    list-style: none;
    padding-inline-start: 0;
    margin-bottom: 0;
  }
</style>

<BaseLayout pageTitle={pageTitle}>
  <main>
    <article class="flow">
      <h1>{pageTitle}</h1>
      <p>
        A collection of journal entries I've written. Keep what resonates and
        leave the rest. &#x270c;
      </p>
      <p>Read my latest. <a href="/journal/mock">&#x2192;</a></p>
      <h2>All Entries</h2>
      <ul>
        {
          allEntries.map((entry: any) => (
            <JournalEntryCard
              url={`/journal/${entry.id}`}
              title={entry.data.title}
              pubDate={entry.data.pubDate.toLocaleDateString(locale, options)}
              lede={entry.data.lede}
            />
          ))
        }
      </ul>
    </article>
  </main>
</BaseLayout>

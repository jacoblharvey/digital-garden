---
import { getCollection } from "astro:content";

import JournalEntryCard from "@components/JournalEntryCard.astro";
import BaseLayout from "@layouts/BaseLayout.astro";

const allEntries = await getCollection("journal");
const pageTitle = "Journal";
const locale = "en-US";
const options = {
  month: "short",
  day: "numeric",
  year: "numeric",
};

// Sort entries by pubDate
allEntries.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
let firstEntry = allEntries.length > 0 ? allEntries[0] : undefined;
---

<style lang="scss">
  ul {
    margin-bottom: 0;
    list-style: none;
    padding-inline-start: 0;
  }
</style>

<BaseLayout pageTitle={pageTitle}>
  <main class="flow">
    <h1>{pageTitle}</h1>
    <p>
      A collection of journal entries I've written. Keep what resonates and
      leave the rest. &#x270c;
    </p>
    <p>
      Read my latest. <a href={`/journal/${firstEntry.id}`}>&#x2192;</a>
    </p>
    <h2>All Entries</h2>
    <!-- TODO: Add pagination at some point https://developers.google.com/search/docs/specialty/ecommerce/pagination-and-incremental-page-loading -->
    <!-- TODO: Add journal search https://github.com/shishkin/astro-pagefind -->
    <ul>
      {
        allEntries.map((entry) => (
          <JournalEntryCard
            url={`/journal/${entry.id}`}
            title={entry.data.title}
            pubDate={entry.data.pubDate.toLocaleDateString(locale, options)}
            lede={entry.data.lede}
          />
        ))
      }
    </ul>
  </main>
</BaseLayout>

---
import BaseLayout from "@layouts/BaseLayout.astro";

const pageTitle = "About";
---

<BaseLayout pageTitle={pageTitle}>
  <main>
    <article class="flow">
      <h1>{pageTitle}</h1>
      <p>
        This website is a term project for CSCE 464. The goal of this project is
        to create a personal site that will evolve as I learn web development.
      </p>
      <p>
        Source code can be found on <a
          href="https://github.com/jacoblharvey/digital-garden"
          target="_blank">GitHub</a
        >.
      </p>
      <h2>About Me</h2>
      <p>
        Hi my name is Jacob and I'm a senior Computer Science student. I love
        diving into random topics, but am usually pretty bad about writing what
        I learn down. Hopefully building this website will help me develop that
        habit and create a space for me to keep track of what I'm exploring at
        the moment.
      </p>
    </article>
  </main>
</BaseLayout>

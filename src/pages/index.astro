---
import BaseLayout from "@layouts/BaseLayout.astro";

const pageTitle = "Home";
let greetings = ["Hello", "Hi", "Hey", "Hiya", "Howzit"];
---

<BaseLayout pageTitle={pageTitle}>
  <main class="flow">
    <h2>{greetings[Math.floor(Math.random() * greetings.length)]} &#x270b;</h2>
    <p>
      This site is a work in progess. See <a href="/about">About</a>
      to learn more.
    </p>
    <p>
      If you're feeling creative, try writing <a href="/four-lines"
        >Four Lines</a
      >.
    </p>
    <p>
      Check out my <a href="/journal">Journal</a> entries! Or don't, I'm not your
      boss.
    </p>
  </main>
</BaseLayout>

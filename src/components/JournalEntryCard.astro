---
const { title, url, pubDate, lede } = Astro.props;
---

<style lang="scss">
  @use "@styles/size-steps";
  @use "@styles/weights";
  @use "@styles/colors";

  li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 8px;
    border-top: 1px solid colors.$border;
  }

  li:not(:last-child) {
    padding-bottom: 8px;
  }

  svg {
    display: block;
  }

  a {
    font-weight: weights.$semibold;
    text-decoration: none;
  }

  li > a {
    padding: 8px;
  }

  a:hover {
    text-decoration: underline;
  }

  p {
    font-size: size-steps.$step-0;
  }

  .card {
    // Overflow text at svg padding
    max-width: calc(100% - 40px);
  }

  .card > p {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .card-title > p {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .card-byline {
    color: colors.$battleship-gray;
    font-weight: weights.$medium;
  }
</style>

<li>
  <div class="card">
    <a class="card-title" href={url}><p>{title}</p></a>
    <p class="card-lede">{lede}</p>
    <p class="card-byline">{pubDate}</p>
  </div>
  <a href={url}>
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none">
      <path
        fill="#000"
        fill-rule="evenodd"
        d="M13.475 19.03a.75.75 0 0 0 1.06 0l6.25-6.25a.75.75 0 0 0 0-1.06l-6.25-6.25a.75.75 0 1 0-1.06 1.06l4.97 4.97H3.75a.75.75 0 1 0 0 1.5h14.695l-4.97 4.97a.75.75 0 0 0 0 1.06Z"
        clip-rule="evenodd"></path>
    </svg>
  </a>
</li>

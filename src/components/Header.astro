---
import Navigation from "./Navigation.astro";
const pathname = Astro.url.pathname;
---

<style lang="scss">
  @use "@styles/colors";
  @use "@styles/weights";

  header {
    position: relative;
    display: flex;
    width: 100%;
    max-width: 768px;
    align-items: center;
    justify-content: space-between;
    padding: 16px;
    border-bottom: 1px solid colors.$border;
    margin: 0 auto 32px;

    a {
      position: absolute;
      top: 12px;
      left: 24px;
      font-size: 1.8rem;
      font-weight: weights.$bold;
      text-decoration: none;
    }

    .active {
      cursor: default;
      pointer-events: none;
    }
  }
</style>

<header>
  <a href="/" class={pathname === "/" ? "active" : ""}>Jacob Harvey</a>
  <Navigation />
</header>

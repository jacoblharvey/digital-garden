---
import Navigation from "./Navigation.astro";
---

<style lang="scss">
  @use "@styles/colors";
  @use "@styles/weights";

  header {
    border-bottom: 1px solid colors.$border;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px;
    margin: 0 auto 32px;
    position: relative;
    width: 100%;
    max-width: 768px;

    a {
      font-weight: weights.$bold;
      font-size: 1.8rem;
      text-decoration: none;
      position: absolute;
      top: 12px;
      left: 24px;
    }
  }
</style>

<header>
  <a href="/">Jacob Harvey</a>
  <Navigation />
</header>

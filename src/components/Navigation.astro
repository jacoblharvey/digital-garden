---
const pathname = Astro.url.pathname;
---

<style lang="scss">
  @use "@styles/colors";
  @use "@styles/weights";

  nav {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
  }

  button {
    border: 0;
    background-color: colors.$light;
    display: block;
    padding: 8px;
    cursor: pointer;
    align-self: flex-end;
  }

  svg {
    display: block;
  }

  ul {
    list-style: none;
    padding: 0;
    margin: 16px 0 0;
    display: none;
  }

  li {
    text-align: center;
  }

  a {
    padding: 12px 16px;
    display: block;
    font-size: 1.4rem;
    font-weight: weights.$semibold;
    position: relative;
    text-decoration: none;
  }

  a:not(.active)::before {
    content: "";
    position: absolute;
    width: 60%;
    height: 2px;
    border-radius: 2px;
    background-color: colors.$dark;
    bottom: 20%;
    left: 20%;
    transform-origin: right;
    transform: scaleX(0);
    transition: transform 0.15s ease-out;
  }

  a:not(.active):hover::before {
    transform-origin: left;
    transform: scaleX(1);
  }

  .active {
    cursor: default;
    pointer-events: none;
  }

  .active::before {
    content: "\261e\0020\0020";
    white-space: pre;
  }

  .active::after {
    content: "\0020\0020\261c";
    white-space: pre;
  }

  .hidden {
    display: none;
  }

  .open {
    display: grid;
  }
</style>

<nav id="menu">
  <button id="menu-button">
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none">
      <path
        fill="#000"
        fill-rule="evenodd"
        d="M2 5.75A.75.75 0 0 1 2.75 5h18.5a.75.75 0 0 1 0 1.5H2.75A.75.75 0 0 1 2 5.75Zm0 6a.75.75 0 0 1 .75-.75h18.5a.75.75 0 0 1 0 1.5H2.75a.75.75 0 0 1-.75-.75Zm0 6a.75.75 0 0 1 .75-.75h18.5a.75.75 0 0 1 0 1.5H2.75a.75.75 0 0 1-.75-.75Z"
        clip-rule="evenodd"></path>
    </svg>
    <svg
      class="hidden"
      xmlns="http://www.w3.org/2000/svg"
      width="24"
      height="24"
      fill="none"
    >
      <path
        fill="#000"
        fill-rule="evenodd"
        d="M5.22 5.22a.75.75 0 0 1 1.06 0L12 10.94l5.72-5.72a.75.75 0 1 1 1.06 1.06L13.06 12l5.72 5.72a.75.75 0 1 1-1.06 1.06L12 13.06l-5.72 5.72a.75.75 0 0 1-1.06-1.06L10.94 12 5.22 6.28a.75.75 0 0 1 0-1.06Z"
        clip-rule="evenodd"></path>
    </svg>
  </button>
  <ul id="menu-links">
    <li>
      <a href="/about" class={pathname === "/about" ? "active" : ""}>About</a>
    </li>
    <li>
      <a href="/journal" class={pathname === "/journal" ? "active" : ""}
        >Journal</a
      >
    </li>
  </ul>
</nav>

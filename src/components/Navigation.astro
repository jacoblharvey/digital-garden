---

<style lang="scss">
  nav {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
  }

  button {
    border: 0;
    background-color: #fff;
    display: block;
    padding: 8px;
    cursor: pointer;
    align-self: flex-end;
  }

  svg {
    display: block;
  }

  ul {
    list-style: none;
    padding: 0;
    margin: 16px 0 0;
    display: none;
  }

  li {
    text-align: center;
  }

  a {
    padding: 12px 16px;
    display: block;
    font-size: 1.2rem;
  }

  .hidden {
    display: none;
  }

  .open {
    display: grid;
  }
</style>

<nav>
  <button>
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none">
      <path
        fill="#000"
        fill-rule="evenodd"
        d="M2 5.75A.75.75 0 0 1 2.75 5h18.5a.75.75 0 0 1 0 1.5H2.75A.75.75 0 0 1 2 5.75Zm0 6a.75.75 0 0 1 .75-.75h18.5a.75.75 0 0 1 0 1.5H2.75a.75.75 0 0 1-.75-.75Zm0 6a.75.75 0 0 1 .75-.75h18.5a.75.75 0 0 1 0 1.5H2.75a.75.75 0 0 1-.75-.75Z"
        clip-rule="evenodd"></path>
    </svg>
    <svg
      class="hidden"
      xmlns="http://www.w3.org/2000/svg"
      width="24"
      height="24"
      fill="none"
    >
      <path
        fill="#000"
        fill-rule="evenodd"
        d="M5.22 5.22a.75.75 0 0 1 1.06 0L12 10.94l5.72-5.72a.75.75 0 1 1 1.06 1.06L13.06 12l5.72 5.72a.75.75 0 1 1-1.06 1.06L12 13.06l-5.72 5.72a.75.75 0 0 1-1.06-1.06L10.94 12 5.22 6.28a.75.75 0 0 1 0-1.06Z"
        clip-rule="evenodd"></path>
    </svg>
  </button>
  <ul>
    <li><a href="/about/">About</a></li>
  </ul>
</nav>

<script type="module">
  const buttons = document.querySelectorAll("button");
  const svgs = document.querySelectorAll("svg");
  const menuItems = document.querySelectorAll("ul");
  buttons.forEach((button) => {
    button.addEventListener("click", () => {
      svgs.forEach((svg) => {
        svg.classList.toggle("hidden");
      });

      menuItems.forEach((item) => {
        item.classList.toggle("open");
      });
    });
  });
</script>
